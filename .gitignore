# =============================================================================
# VISTA .gitignore - Comprehensive Exclusion Rules
# =============================================================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so

# --- Virtual environments ---
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --- Environment variables & secrets ---
.env
.env.*
*.local.env
!*.env.example

# --- Logs & Telemetry ---
*.log
*.log.*
logs/

# --- Datasets & Raw Data Lake Archives (Keep Local Only) ---
phase1_dataset/
phase1_dataset.zip
data/
outputs/
RESULT/
*.csv
*.tsv
*.xlsx
*.parquet
*.zip
*.tar.gz
*.tar
*.7z
*.rar
*.gz

# --- Vector Embeddings & Model Weights ---
*.npy
*.npz
*.pt
*.pth
*.bin
*.onnx
*.safetensors
models/
hf_cache/
.cache/

# --- Database & Vector indices ---
*.duckdb
*.duckdb.wal
*.faiss
*.index
*.db
*.sqlite
*.sqlite3

# --- MinIO & Object Storage Local Dirs ---
minio_data/

# --- Distribution & Packaging ---
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing & Coverage ---
.coverage
.coverage.*
.pytest_cache/
htmlcov/
scratch/

# --- IDE & Editor Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
