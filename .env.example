# VISTA phase-1 environment. Copy to .env and adjust if needed.
# MinIO object storage (docker-compose.yml)
MINIO_ROOT_USER=vistaadmin
MINIO_ROOT_PASSWORD=vista-secret-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Endpoint used by the ETL pipeline when uploading to MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=vista-lake
