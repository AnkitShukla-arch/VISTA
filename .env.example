# VISTA Environment Configuration Template

# MinIO Object Storage (docker-compose.yml / manage_vista.sh)
MINIO_ROOT_USER=vistaadmin
MINIO_ROOT_PASSWORD=vista-secret-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=vista-lake
MINIO_ACCESS_KEY=vistaadmin
MINIO_SECRET_KEY=vista-secret-1
MINIO_SECURE=False
MINIO_BUCKET_NAME=medical-reports

# Neon PostgreSQL Relational Warehouse
NEON_DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/medicaldb?sslmode=require

# DuckDB Analytics
DUCKDB_PATH=Database/DuckDB/data/metadata.duckdb

# Embedding Model (Sentence Transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# FAISS Box Index
FAISS_INDEX_PATH=Backend/Clustering/data/box_index.faiss
FAISS_METADATA_PATH=Backend/Clustering/data/box_metadata.json

# Dataset Paths
DATASET_ROOT=phase1_dataset/phase1_dataset
REPORTS_DIR=phase1_dataset/phase1_dataset/Reports
MTSAMPLES_CSV=phase1_dataset/phase1_dataset/medical_data_lake_bundle/combined_dataset.csv
DATA_LAKE_DIR=phase1_dataset/phase1_dataset/Full_Medical_Data_Lake
RESULT_DIR=RESULT/clean_data
